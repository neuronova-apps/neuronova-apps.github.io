{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": ["http://localhost/"],
      "numberOfRuns": 5,
      "settings": {
        "preset": "desktop",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"],
        "chromeFlags": "--headless --no-sandbox --disable-gpu"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", {"minScore": 0.90, "aggregationMethod": "median"}],
        "categories:accessibility": ["warn", {"minScore": 0.95, "aggregationMethod": "median"}],
        "categories:best-practices": ["warn", {"minScore": 0.95, "aggregationMethod": "median"}],
        "categories:seo": ["warn", {"minScore": 0.95, "aggregationMethod": "median"}]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "artifacts/lighthouse/desktop"
    }
  }
}
